{
  "expo": {
    "name": "Aitu Dating",
    "slug": "aitu-dating",
    "scheme": "aitudating",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-status-bar"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
